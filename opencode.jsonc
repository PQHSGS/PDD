{
  "$schema": "https://opencode.ai/config.json",
  // OpenCode Quota: tuiCommandDisplay chooses whether native TUI command output appears in the session transcript or a local popup dialog.
  // OpenCode Quota: loads the server plugin for slash commands and quota checks.
  "plugin": [
    "@gotgenes/opencode-agent-identity@3.1.1",
    "@slkiser/opencode-quota@3.10.1",
    "@mohak34/opencode-notifier@0.2.8"
  ],
  "agent": {
    "research": {
      "description": "Research methodology agent for paper criticism, experimental design, hypothesis reasoning, and bridging literature to our safety ceiling problem.",
      "mode": "primary"
    },
    "code-cleaner": {
      "description": "Code Cleaner agent. Removes redundant/duplicate code, implicit fallbacks, un-needed if-else, and fixes function sizing/overlap without changing behavior. Use when asked to clean up, simplify, refactor, or tidy the viewer (pdd/viewer_server.py, viewer/app.js) or auto-label pipeline (pdd/autolabel.py).",
      "mode": "primary"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
